---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Freelance × AI | フリーランス × AI の開発パートナー",
  description = "制作会社の高さとクラウドソーシングの不安、そのあいだを TypeScript と AI でつなぐ開発パートナー。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:inline>
      html:not(.is-unlocked) { overflow: hidden; }
      html:not(.is-unlocked) body > :not(.gate) { display: none; }
    </style>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (sessionStorage.getItem("fa-unlocked") === "1") {
          document.documentElement.classList.add("is-unlocked");
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="gate" data-gate>
      <form class="gate-card" data-gate-form>
        <p class="gate-kicker">Freelance × AI</p>
        <h1 class="gate-title">閲覧パスワード</h1>
        <p class="gate-lede">公開前のため、パスワードを入力してください。</p>
        <label class="gate-label">
          <span class="gate-label-text">パスワード</span>
          <input
            data-gate-input
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </label>
        <p class="gate-error">パスワードが違います。</p>
        <button class="btn btn-primary" type="submit">入る</button>
      </form>
    </div>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />
    <script>
      import { initGate } from "../scripts/gate";
      import { initUI } from "../scripts/ui";
      initGate();
      initUI();
    </script>
  </body>
</html>
